            "instance": "964f30d5-5472-4687-8cea-a0098354a84a",
            "properties": [
                [
                    "name",
                    "Domain Accounts"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1078.002"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages compromised domain accounts to gain and maintain access within victim environments. Credentials obtained through phishing, malware, credential dumping, or other theft techniques are used to authenticate to domain-joined systems, access network resources, and facilitate lateral movement across the enterprise. By abusing legitimate domain accounts, Lazarus can blend malicious activity with normal user behavior, evade detection, establish persistence, and access sensitive systems and data in support of espionage, financial theft, and other cyber operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
