        {
            "id": "action",
            "instance": "e2f9b63f-ed8d-4d77-a5e4-8298de824e8a",
            "properties": [
                [
                    "name",
                    "External Remote Services"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1133"
                        ]
                    ]
                ],
                [
                    "description",
                    "Mustang Panda leverages external remote services, such as VPNs, remote desktop solutions, and other internet-accessible remote access platforms, to gain and maintain access to victim environments. The group may use compromised credentials obtained through phishing or other credential theft techniques to authenticate to these services and bypass perimeter defenses. By abusing legitimate remote access mechanisms, Mustang Panda can establish a foothold within targeted networks, maintain persistent access, and conduct reconnaissance, data collection, and other espionage-related activities while blending in with normal user behavior."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
