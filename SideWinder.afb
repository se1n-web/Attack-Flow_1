        {
            "id": "action",
            "instance": "27542c80-4c91-4ef3-9da4-e99049192ca7",
            "properties": [
                [
                    "name",
                    "Phishing"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566"
                        ]
                    ]
                ],
                [
                    "description",
                    "Sidewinder leverages phishing campaigns as an initial access vector to compromise targeted environments. The group distributes deceptive emails designed to impersonate trusted organizations, government entities, or business contacts in order to trick recipients into opening malicious attachments, clicking malicious links, or revealing sensitive credentials. Successful phishing attempts enable Sidewinder to establish an initial foothold within victim systems, deploy additional payloads, and facilitate credential access, persistence, and follow-on espionage activities within the targeted network."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
