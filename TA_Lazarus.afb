        {
            "id": "action",
            "instance": "b9c9a50e-652e-492b-b860-779162b0bece",
            "properties": [
                [
                    "name",
                    "Spearphishing via Service"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566.003"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages third-party messaging, social networking, and professional networking services to deliver targeted spearphishing content to intended victims. The group has been known to use platforms such as email services, messaging applications, and professional networking sites to impersonate recruiters, business contacts, or trusted organizations and distribute malicious links, documents, or payloads. By abusing legitimate services, Lazarus increases the credibility of its phishing attempts and reduces suspicion, enabling the theft of credentials, malware deployment, and the establishment of an initial foothold within victim environments."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
