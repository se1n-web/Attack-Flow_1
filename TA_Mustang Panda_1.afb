        {
            "id": "action",
            "instance": "a02764ea-d14b-464d-877a-ab7cdff80bf2",
            "properties": [
                [
                    "name",
                    "Spearphishing Link"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566.002"
                        ]
                    ]
                ],
                [
                    "description",
                    "Mustang Panda leverages targeted spearphishing emails containing malicious links to gain initial access to victim environments. These emails are often tailored to the target and impersonate trusted organizations, government entities, or business contacts to increase the likelihood of user interaction. The embedded links may direct victims to credential harvesting pages, malware-hosting websites, or attacker-controlled infrastructure. Successful interaction with these links enables Mustang Panda to obtain credentials, deploy malware, and establish a foothold within the compromised environment to support its espionage operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
