            "instance": "b2dbf158-2427-4676-8c4b-18ffc9290f29",
            "properties": [
                [
                    "name",
                    "CVE-2022-40684 (Fortinet FortiOS / FortiProxy)"
                ],
                [
                    "description",
                    "FortiOS operates FortiGate firewalls and SSL VPN solutions. By sending a crafted HTTP/HTTPS request to the public-facing administrative web interface, a remote attacker could perform actions on the edge firewall as an administrator, enabling full edge compromise."
                ]
            ],
