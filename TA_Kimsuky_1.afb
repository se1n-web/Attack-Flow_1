{"schema": "attack_flow_v2", "theme": "dark_theme", "objects": [{"id": "flow", "instance": "943b177f-56e2-4270-95c7-2e1d9f666f94", "properties": [["name", "Kimsuky"], ["description", null], ["author", [["name", "BBS CTI"], ["identity_class", "organization"], ["contact_information", null]]], ["scope", "incident"], ["classification", [["marking", null], ["group", null]]], ["external_references", [["f03374870f3d43905f63f4e336204d1b", [["source_name", "FBI - IC3"], ["description", null], ["url", "https://www.ic3.gov/CSA/2026/260108.pdf"]]]]], ["created", {"time": "2026-06-18T16:00:00.000+08:00", "zone": "Asia/Manila"}]], "objects": ["62b5a5b6-d8fb-41d8-8553-d295252c204c", "4a327a17-cb95-414b-880b-f3785cb28a92", "920f7463-6b7a-4c30-9a17-7aebe4fde427", "f0924a62-b30a-49f9-9481-c9c62b5f22e2", "65eecc75-ea77-49c1-80d4-f6f8dbb78f6d", "09d9511a-cb75-459d-8275-d328845ec858", "028a1e34-d29b-4218-b221-ee296939fc75", "6840162e-e42a-4c73-9f9e-ac50be35f291", "14dbd5a8-0639-44b1-ad00-e144f9fbae4d", "79e8dc94-6dba-4df9-b591-a66375b354d4", "505d05d0-574f-4175-aded-1d4257eb244b", "5ddb7f03-45c1-44ee-b403-1ee970362c34", "74e82b1e-5365-4204-87f9-85f4104f265f", "d1bd58b9-d4ae-43f3-aeeb-cf5eace69d23", "423dca5f-9251-430d-9869-513bf893bdf5", "58f251cf-9b55-4ed2-be87-c3b73b1e024d", "1bb94cae-4f45-44a5-98ec-cd476e5d5dcf", "e8b64ff4-170a-48a9-9744-4919d6223009", "c6d8b843-cd3f-4596-83a8-9dc9fd91d873", "191f1d59-fb1c-46e4-ad44-fe79819727a8"]}, {"id": "horizontal_anchor", "instance": "70eceef5-910a-42f0-b0d4-e7f12e375961", "latches": []}, {"id": "horizontal_anchor", "instance": "ad39dc7b-6180-42dc-80f6-40d9cca28ad1", "latches": []}, {"id": "vertical_anchor", "instance": "65de1d5d-4667-4685-b063-1689dc06762c", "latches": []}, {"id": "vertical_anchor", "instance": "3b6e0e31-e3ec-452c-856a-552c55c6294a", "latches": ["565a06cc-5fd2-44ad-aa16-f9ae162ccdd0"]}, {"id": "vertical_anchor", "instance": "9ab1d8d6-2707-4a05-b695-c6b9cfceef1a", "latches": ["18497a2a-3f19-433d-8a5a-b13e780a0506"]}, {"id": "horizontal_anchor", "instance": "1a8f547b-3e56-4caa-bc3d-7e2c5ad586b0", "latches": []}, {"id": "horizontal_anchor", "instance": "946ee676-8162-4625-9556-6f2a3f233238", "latches": []}, {"id": "horizontal_anchor", "instance": "de460726-50c3-4ce4-bf4a-5b06880888d4", "latches": []}, {"id": "vertical_anchor", "instance": "0edd0189-be50-4704-ab2f-5414b4c4840c", "latches": []}, {"id": "vertical_anchor", "instance": "36160507-23c5-4c15-982f-2576be861cbd", "latches": []}, {"id": "vertical_anchor", "instance": "9a6e6ce9-7915-4610-9d16-dec8c2574d9f", "latches": []}, {"id": "horizontal_anchor", "instance": "a0d5875d-d597-42ca-9cde-222c7e597005", "latches": []}, {"id": "action", "instance": "62b5a5b6-d8fb-41d8-8553-d295252c204c", "properties": [["name", "Phishing"], ["ttp", [["tactic", "TA0001"], ["technique", "T1566"]]], ["description", "Kimsuky relies on phishing as its primary initial access vector, running highly targeted social-engineering campaigns against government, diplomatic, academic, and research targets. The group impersonates trusted institutions, journalists, and colleagues, and is notable for sending lures from previously compromised accounts to reach trusted contacts and partner organizations. Campaigns combine link-based and attachment-based lures with QR-code (quishing) redirects to credential-harvesting portals. Successful phishing lets Kimsuky harvest credentials and session tokens and establish an initial foothold in support of its espionage operations."], ["confidence", null], ["execution_start", null], ["execution_end", null]], "anchors": {"0": "70eceef5-910a-42f0-b0d4-e7f12e375961", "30": "ad39dc7b-6180-42dc-80f6-40d9cca28ad1", "60": "65de1d5d-4667-4685-b063-1689dc06762c", "90": "3b6e0e31-e3ec-452c-856a-552c55c6294a", "120": "9ab1d8d6-2707-4a05-b695-c6b9cfceef1a", "150": "1a8f547b-3e56-4caa-bc3d-7e2c5ad586b0", "180": "946ee676-8162-4625-9556-6f2a3f233238", "210": "de460726-50c3-4ce4-bf4a-5b06880888d4", "240": "0edd0189-be50-4704-ab2f-5414b4c4840c", "270": "