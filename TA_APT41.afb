        {
            "id": "action",
            "instance": "c94f0e6b-30c9-42b6-a09b-f0796f35e143",
            "properties": [
                [
                    "name",
                    "Phishing"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566"
                        ]
                    ]
                ],
                [
                    "description",
                    "APT41 leverages phishing campaigns to gain initial access to victim environments. The group distributes deceptive emails that impersonate trusted organizations, business partners, or legitimate services to entice recipients into opening malicious attachments, clicking malicious links, or providing credentials. Successful phishing attacks enable APT41 to deploy malware, harvest credentials, establish persistence, and gain a foothold within targeted networks, supporting both espionage and financially motivated operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
