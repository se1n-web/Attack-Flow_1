        {
            "id": "action",
            "instance": "8aa9b374-86ca-4758-9580-54799fb711bf",
            "properties": [
                [
                    "name",
                    "Spearphishing Link"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566.002"
                        ]
                    ]
                ],
                [
                    "description",
                    "Sidewinder leverages targeted spearphishing emails containing malicious links to gain initial access to victim environments. These emails are often carefully crafted to appear as legitimate communications from trusted organizations, government entities, or business partners relevant to the target. The embedded links typically lead to credential harvesting pages, malware delivery sites, or attacker-controlled infrastructure. Successful interaction with these links enables Sidewinder to obtain credentials, deploy malware, establish persistence, and conduct follow-on espionage operations within compromised networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
