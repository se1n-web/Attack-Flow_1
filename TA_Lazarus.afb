        {
            "id": "action",
            "instance": "04ed2ef7-b92f-47a3-882a-6d26cc633f60",
            "properties": [
                [
                    "name",
                    "Local Accounts"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1078.003"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages compromised or attacker-controlled local accounts to gain and maintain access to systems within victim environments. By abusing valid local credentials, the group can authenticate to endpoints, execute commands, establish persistence, and support lateral movement activities. The use of legitimate local accounts allows Lazarus to blend malicious actions with normal administrative activity, reducing the likelihood of detection while facilitating reconnaissance, credential access, malware deployment, and other post-compromise operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
