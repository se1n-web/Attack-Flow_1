        {
            "id": "action",
            "instance": "68f0b8ba-776b-4398-9907-3884bb674d92",
            "properties": [
                [
                    "name",
                    "External Remote Services"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1133"
                        ]
                    ]
                ],
                [
                    "description",
                    "Jasper Sleet leverages external remote services such as VPNs, Remote Desktop Protocol (RDP), and other internet-facing remote access platforms to gain and maintain access to victim environments. The group often utilizes compromised credentials or weak authentication mechanisms to access these services and bypass perimeter defenses. By abusing legitimate remote access channels, Jasper Sleet can blend into normal administrative activity, establish persistent access, and conduct reconnaissance, lateral movement, and follow-on malicious operations within targeted networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
            "anchors": {
                "0": "e118a84f-eaa5-45f7-b50c-8c9d9cad4200",
