        {
            "id": "action",
            "instance": "e0d6fb14-0b78-4e9c-b44e-a256ded004f3",
            "properties": [
                [
                    "name",
                    "External Remote Services"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1133"
                        ]
                    ]
                ],
                [
                    "description",
                    "Sidewinder leverages external remote services such as VPNs, Remote Desktop Protocol (RDP), and other internet-accessible remote access platforms to gain and maintain access to victim environments. The group frequently abuses weakly secured or compromised credentials to authenticate to these services and bypass perimeter defenses. By exploiting legitimate remote access mechanisms, Sidewinder can blend in with normal user activity, establish persistent access, and conduct reconnaissance, lateral movement, and data exfiltration activities within targeted networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
