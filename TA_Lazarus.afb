        {
            "id": "action",
            "instance": "298cb2ef-1143-47a5-8de7-999095e32cdd",
            "properties": [
                [
                    "name",
                    "Valid Accounts"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1078"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages valid accounts obtained through phishing, credential theft, social engineering, or other compromise methods to gain and maintain access to victim environments. By abusing legitimate user credentials, the group can authenticate to systems, cloud services, email platforms, and network resources while blending in with normal user activity. The use of valid accounts enables Lazarus to evade detection, conduct reconnaissance, establish persistence, move laterally, access sensitive information, and support espionage, financial theft, and other malicious operations within compromised networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
