                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566.002"
                        ]
                    ]
                ],
                [
                    "description",
                    "Threat Actors leverages targeted spearphishing emails containing malicious links to gain initial access to victim environments. These emails are often disguised as legitimate communications and are designed to entice recipients into visiting attacker-controlled websites, downloading malicious payloads, or entering credentials into fraudulent login pages. Successful interaction with these links enables MuddyWater to harvest credentials, deploy malware, and establish a foothold within victim networks."
                ],
                [
                    "confidence",
                    null
                ],
