        {
            "id": "action",
            "instance": "53fbcce5-8410-4b40-85cd-a28120329d5a",
            "properties": [
                [
                    "name",
                    "Phishing"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566"
                        ]
                    ]
                ],
                [
                    "description",
                    "Mustang Panda leverages phishing campaigns as a primary method of gaining initial access to targeted organizations. The group distributes carefully crafted emails that impersonate trusted entities, government agencies, business partners, or event organizers to entice recipients into opening malicious attachments, clicking malicious links, or providing credentials. Successful phishing attempts enable Mustang Panda to deploy malware, establish persistence, harvest credentials, and gain a foothold within victim environments to support its cyber espionage operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
