        {
            "id": "action",
            "instance": "63d21915-d87b-4469-933f-c2328bfad004",
            "properties": [
                [
                    "name",
                    "External Remote Services"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1133"
                        ]
                    ]
                ],
                [
                    "description",
                    "APT41 leverages external remote services, such as VPNs, Remote Desktop Protocol (RDP), Citrix environments, and other internet-accessible remote access solutions, to gain and maintain access to victim networks. The group frequently utilizes valid credentials obtained through phishing, credential theft, or other compromise methods to authenticate to these services and bypass perimeter defenses. By abusing legitimate remote access mechanisms, APT41 can blend malicious activity with normal user behavior, establish persistent access, and facilitate reconnaissance, lateral movement, credential access, and data theft within compromised environments."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
