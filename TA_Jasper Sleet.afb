        {
            "id": "action",
            "instance": "8e4422ff-1e25-48df-94f8-276d21b9371e",
            "properties": [
                [
                    "name",
                    "Phishing"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566"
                        ]
                    ]
                ],
                [
                    "description",
                    "Jasper Sleet leverages phishing campaigns as an initial access vector to compromise targeted environments. The group distributes deceptive emails designed to impersonate trusted organizations, services, or individuals in order to trick recipients into opening malicious attachments, clicking embedded links, or disclosing sensitive credentials. Successful phishing attempts enable Jasper Sleet to establish an initial foothold within victim systems, deploy additional payloads, and facilitate credential access, persistence, and follow-on intrusion activities within the targeted network."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
