        {
            "id": "action",
            "instance": "7def1f4f-f2dc-46fa-a766-b79ef2e0013a",
            "properties": [
                [
                    "name",
                    "Exploit Public-Facing Application"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1190"
                        ]
                    ]
                ],
                [
                    "description",
                    "APT41 leverages vulnerabilities in public-facing applications and internet-accessible services to gain initial access to victim environments. The group has been observed exploiting security flaws in web applications, enterprise software, and externally exposed systems to execute malicious code, deploy malware, or obtain unauthorized access. Successful exploitation enables APT41 to establish a foothold within targeted networks, bypass traditional authentication controls, and conduct follow-on activities such as reconnaissance, credential theft, lateral movement, and data exfiltration in support of espionage and financially motivated operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
