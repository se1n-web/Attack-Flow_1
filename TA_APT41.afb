        {
            "id": "action",
            "instance": "67e2bd3d-2c03-4dc6-bfea-6c3c219314b4",
            "properties": [
                [
                    "name",
                    "Spearphishing Link"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566.002"
                        ]
                    ]
                ],
                [
                    "description",
                    "APT41 leverages targeted spearphishing emails containing malicious links to gain initial access to victim environments. These emails are often tailored to the target and designed to appear as legitimate communications from trusted organizations, business partners, or service providers. The embedded links may direct victims to credential harvesting pages, malware-hosting websites, or attacker-controlled infrastructure. Successful interaction with these links enables APT41 to obtain credentials, deploy malware, establish persistence, and facilitate subsequent espionage or financially motivated operations within compromised networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
