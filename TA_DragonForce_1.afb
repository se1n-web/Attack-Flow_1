5c-8f676d6b47e6", "properties": [["name", "Exploit Public-Facing Application"], ["ttp", [["tactic", "TA0001"], ["technique", "T1190"]]], ["description", "DragonForce affiliates exploit vulnerabilities in internet-facing applications, services, and remote management software to gain initial access. Successful exploitation provides a foothold on externally exposed systems and a path to pivot into internal networks ahead of credential theft, lateral movement, and ransomware deployment."], ["confidence", null], ["execution_start", null], ["execution_end", null]], "anchors": {"0": "377a032c-f8c3-43ad-9ec6-d1d146cd332f", "30": "888aa5d5-2438-4843-a5a7-385d2389f1f4", "60": "4b8baf46-eea1-411f-8b02-a2d74514e53e", "90": "b39784ba-7c74-4820-a0a4-a5df5264e991", "120": "c5d6d11d-f1ca-49c4-af55-83f9865b01c1", "150": "c41d8493-21bd-455d-844b-a5e94ca47ad6", "180": "1a3eb07c-1beb-42bb-bb25-2d0de91a8bee", "210": "dc889a08-7658-4b7f-9c37-d3f78373f268", "240": "138a8171-2913-4070-a890-ea809573afae", "270": "1a39d193-b2e8-4d99-929b-901a7007b878", "300": "5d65b8ba-d907-43b1-b696-50508c0cbda2", "330": "74d3b330-4977-429e-a72f-ca6b32292214"}}, {"id": "horizontal_anchor", "instance": "21cde23d-9bb7-4037-9dcb-9dd654241233", "latches": []}, {"id": "horizontal_anchor", "instance": "2775e501-3036-4f2c-8617-c979365866c4", "latches": ["3ba0ef5a-02d3-45e3-abd8-4a4d46997483"]}, {"id": "vertical_anchor", "instance": "39f3b268-43f4-425b-9793-6bd4f5c5e6ee", "latches": ["1bc68a30-28d0-4b99-ab3e-41ac25e662ac"]}, {"id": "vertical_anchor", "instance": "0c6623fb-b4ca-4f89-ad72-885fe473c45c", "latches": ["2f03b602-6afa-4273-8eaf-a5fe5e7d8c3a"]}, {"id": "vertical_anchor", "instance": "2d270989-30fb-480f-a336-eb7f0425497a", "latches": ["ae7cc1cf-57ce-400f-817b-b1c1e17ed741"]}, {"id": "horizontal_anchor", "instance": "46074521-be66-4042-8176-29c2de2b264d", "latches": ["51b35026-62d3-4f39-b96b-d73e96e05483"]}, {"id": "horizontal_anchor", "instance": "2dbe58ae-2bee-403e-809a-c5f20d8e8524", "latches": []}, {"id"