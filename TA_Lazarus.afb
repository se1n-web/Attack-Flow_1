        {
            "id": "action",
            "instance": "584c8002-60dd-4c8c-a761-608922f4457e",
            "properties": [
                [
                    "name",
                    "Exploit Public-Facing Application"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1190"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages vulnerabilities in internet-exposed applications and services to gain initial access to victim environments. The group has been observed exploiting security flaws in web applications, enterprise systems, and other publicly accessible services to execute malicious code, deploy payloads, or obtain unauthorized access. Successful exploitation allows Lazarus to establish a foothold within targeted networks, bypass authentication controls, and conduct follow-on activities such as reconnaissance, credential theft, lateral movement, and data exfiltration in support of espionage, financial theft, and disruptive cyber operations."
                ],
                [
                    "confidence",
                    null
                ],
