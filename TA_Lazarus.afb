        {
            "id": "action",
            "instance": "6ee94c79-bb01-45d6-968b-0254c1edc986",
            "properties": [
                [
                    "name",
                    "Spearphishing Link"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566.002"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages targeted spearphishing emails containing malicious links to gain initial access to victim environments. These emails are often carefully crafted to appear as legitimate communications from recruiters, business partners, financial institutions, or trusted organizations and are designed to entice recipients into clicking embedded URLs. The links may direct victims to credential harvesting pages, malware-hosting websites, or attacker-controlled infrastructure. Successful interaction with these links enables Lazarus to obtain credentials, deploy malware, establish persistence, and facilitate subsequent espionage, financial theft, or disruptive cyber operations within compromised networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
