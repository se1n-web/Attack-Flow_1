                [
                    "name",
                    "CVE-2019-19781 (Citrix ADC / Gateway)"
                ],
                [
                    "description",
                    "Famously known as Shitrix, this bug directly targeted Citrix Application Delivery Controllers and Citrix Gateways (which act as enterprise VPN and remote workspace entry points). Exploiting this public-facing web portal gave attackers instant access to a shell on the gateway device."
                ]
            ],
