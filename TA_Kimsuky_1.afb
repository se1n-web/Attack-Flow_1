5-b6ce2d1f9ea9", "30": "f3986f91-921b-493e-aef4-067da6d6c3d7", "60": "cf7ed336-99e7-4631-a648-31cba0e743ea", "90": "409f70c2-fd69-447f-95af-64aceb775a27", "120": "a5744304-3178-44e9-b356-dd18564bddf0", "150": "eebb99bb-98ec-40de-97f4-e2672a8822fc", "180": "3a75c597-049d-41fb-b6b0-fecd704f1d33", "210": "941f6ab8-a09b-4110-8ee0-31944cba4bca", "240": "ad9f92a8-41fd-40ff-bb3b-374456f070e7", "270": "a5eff80a-ae58-4b19-a2ac-4516fca088a5", "300": "8562e0d8-bcf1-4092-b71e-fdb42738680d", "330": "80ad2259-f300-41ff-9da0-66c571a4aea9"}}, {"id": "horizontal_anchor", "instance": "58b7401e-f75e-4b81-9034-9bc69fc142c7", "latches": []}, {"id": "horizontal_anchor", "instance": "858e5af4-a655-4b3c-b6f8-481ade4702fa", "latches": []}, {"id": "vertical_anchor", "instance": "191e81bd-0aea-45e8-b166-07452b643c50", "latches": []}, {"id": "vertical_anchor", "instance": "816eb715-49ca-478e-9cfb-1a1c8b47fa18", "latches": ["9cb57e95-1270-457f-87d4-fd80b465c296"]}, {"id": "vertical_anchor", "instance": "2636aed5-3714-411d-8a5c-ecac58a412a1", "latches": []}, {"id": "horizontal_anchor", "instance": "24e9917b-d509-4843-9558-21904788499e", "latches": []}, {"id": "horizontal_anchor", "instance": "3abbd90c-f4aa-4fb9-9681-9e3890d09a99", "latches": []}, {"id": "horizontal_anchor", "instance": "af3d50ff-bd86-4e50-a223-d52b6d698ddf", "latches": []}, {"id": "vertical_anchor", "instance": "46805d66-4795-4db6-afd0-458cdf6e9bc0", "latches": []}, {"id": "vertical_anchor", "instance": "1a85c0b4-3d1d-458a-b6bf-8f536b7087d3", "latches": ["4440c3ab-5a50-44a0-ac85-f21f5d0a1fc5"]}, {"id": "vertical_anchor", "instance": "d7b47db2-0e5f-42af-8a18-006dfd09d539", "latches": []}, {"id": "horizontal_anchor", "instance": "a5fbc40a-c6e2-4de0-812e-43d62d0443ac", "latches": []}, {"id": "action", "instance": "920f7463-6b7a-4c30-9a17-7aebe4fde427", "properties": [["name", "Spearphishing Link"], ["ttp", [["tactic", "TA0001"], ["technique", "T1566.002"]]], ["description", "Victims receive phishing emails containing malicious links designed to redirect users to attacker-controlled infrastructure. Kimsuky uses these links to drive targets to credential-harvesting portals and malware-staging sites, capturing credentials and session tokens for follow-on access."], ["confidence", null], ["execution_start", null], ["execution_end", null]], "anchors": {"0": "58b7401e-f75e-4b81-9034-9bc69fc142c7", "30": "858e5af4-a655-4b3c-b6f8-481ade4702fa", "60": "191e81bd-0aea-45e8-b166-07452b643c50", "90": "816eb715-49ca-478e-9cfb-1a1c8b47fa18", "120": "2636aed5-3714-411d-8a5c-ecac58a412a1", "150": "24e9917b-d509-4843-9558-21904788499e", "180": "3abbd90c-f4aa-4fb9-9681-9e3890d09a99", "210": "af3d50ff-bd86-4e50-a223-d52b6d698ddf", "240": "46805d66-4795-4db6-afd0-458cdf6e9bc0", "270": "1a85c0b4-3d1d-458a-b6bf-8f536b7087d3", "300": "d7b47db2-0e5f-42af-8a18-006dfd09d539", "330": "a5fbc40a-c6e2-4de0-812e-43d62d0443ac"}}, {"id": "horizontal_anchor", "instance": "49a07470-272a-4e77-8b59-44da6576af48", "latches": []}, {"id": "horizontal_anchor", "instance": "1bc69863-fa1d-486f-bfe2-7a90b07a0187", "latches": []}, {"id": "vertical_anchor", "instance": "0dcdebc2-0e44-4597-818a-828a2b1d50c8", "latches": []}, {"id": "vertical_anchor", "instance": "5ff9d17f-110f-4763-8b7c-d737058a60ec", "latches": ["5a0ed9fc-44b5-43b6-82c3-8d0097982aa2"]}, {"id": "vertical_anchor", "instance": "16e219c8-7780-4e7d-9ce8-034524ce7585", "latches": []}, {"id": "horizontal_anchor", "instance": "ed85d553-dd86-435d-91e1-9599bc3f60d6", "latches": []}, {"id": "horizontal_anchor", "instance": "fde26975-00b0-4535-b08d-c8fd011e374d", "latches": []}, {"id": "horizontal_anchor", "instance": "5b663b01-e8d0-4384-9c34-8d33e9554b07", "latches": []}, {"id": "vertical_anchor", "instance": "eac503cb-ba56-4c19-8b5e-625f6104b30f", "latches": []}, {"id": "vertical_anchor", "instance": "26d2cc00-eb6e-4adb-8b1b-6eac6f03705a", "latches": []}, {"id": "vertical_anchor", "instance": "4122e709-dab3-4942-8622-195701731d19", "latches": []}, {"id": "horizontal_anchor", "instance": "78e46d6c-8f46-4133-9193-d5801953bd98", "latches": []}, {"id": "action", "instance": "f0924a62-b30a-49f9-9481-c9c62b5f22e2", "properties": [["name", "Valid Accounts"], ["ttp", [["tactic", "TA0001"], ["technique", "T1078"]]], ["description", "Kimsuky uses compromised credentials and reused session tokens to access enterprise services. By authenticating with legitimate accounts and stolen session cookies, the group blends in with normal user activity, evades detection, and maintains durable access for account discovery, email collection, and data exfiltration across compromised environments."], ["confidence", null], ["execution_start", null], ["execution_end", null]], "anchors": {"0": "49a07470-272a-4e77-8b59-44da6576af48", "30": "1bc69863-fa1d-486f-bfe2-7a90b07a0187", "60": "0dcdebc2-0e44-4597-818a-828a2b1d50c8", "90": "5ff9d17f-110f-4763-8b7c-d737058a60ec", "120": "16e219c8-7780-4e7d-9ce8-034524ce7585", "150": "ed85d553-dd86-435d-91e1-9599bc3f60d6", "180": "fde26975-00b0-4535-b08d-c8fd011e374d", "210": "5b663b01-e8d0-4384-9c34-8d33e9554b07", "240": "eac503cb-ba56-4c19-8b5e-625f6104b30f", "270": "26d2cc00-eb6e-4adb-8b1b-6eac6f03705a", "300": "4122e709-dab3-4942-8622-195701731d19", "330": "78e46d6c-8f46-4133-9193-d5801953bd98"}}, {"id": "horizontal_anchor", "instance": "20c7c16d-208c-47b0-8acb-020f63c31459", "latches": []}, {"id": "horizontal_anchor", "instance": "0744ad3f-55d5-4840-8627-92b81a6e3c62", "latches": []}, {"id": "vertical_anchor", "instance": "63cd2682-f683-4b87-81d0-18150f6de689", "latches": []}, {"id": "vertical_anchor", "instance": "4cb4de97-d205-4ae5-bf3d-2bdf8a443e6b", "latches": ["2ce9cb22-106c-4336-91b3-cb70766838ab"]}, {"id": "vertical_anchor", "instance": "d266e60b-5ff7-4860-8057-02238a7d7933", "latches": []}, {"id": "horizontal_anchor", "instance": "f7d13f52-bc2a-47d8-805c-af08dbde2314", "latches": []}, {"id": "horizontal_anchor", "instance": "ef990dc7-f313-4b4f-be28-af53469041bc", "latches": []}, {"id": "horizontal_anchor", "instance": "c7fbe467-9b6c-4352-84f7-15b4ae8fab83", "latches": []}, {"id": "vertical_anchor", "instance": "ef644f08-9e2b-4ae2-9a31-bdecb0426268", "latches": []}, {"id": "vertical_anchor", "instance": "180590f4-1d02-4e2e-85c0-0ce94828d815", "latches": []}, {"id": "vertical_anchor", "instance": "eaadc30a-28c3-41bf-b1ba-8eafb18bb53f", "latches": []}, {"id": "horizontal_anchor", "instance": "0d5e1b9a-3622-4982-ae6c-c4fed4a054ee", "latches": []}, {"id": "action", "instance": "65eecc75-ea77-49c1-80d4-f6f8dbb78f6d", "properties": [["name", "Exploit Public-Facing Application"], ["ttp", [["tactic", "TA0001"], ["technique", "T1190"]]], ["description", "Kimsuky identifies and exploits vulnerabilities in internet-facing applications and services to gain access to victim environments. Successful exploitation lets the group establish a foothold on externally exposed systems and pivot toward internal networks in support of its espionage objectives."], ["confidence", null], ["execution_start", null], ["execution_end", null]], "anchors": {"0": "20c7c16d-208c-47b0-8acb-020f63c31459", "30": "0744ad3f-55d5-4840-8627-92b81a6e3c62", "60": "63cd2682-f683-4b87-81d0-18150f6de689", "90": "4cb4de97-d205-4ae5-bf3d-2bdf8a443e6b", "120": "d266e60b-5ff7-4860-8057-02238a7d7933", "150": "f7d13f52-bc2a-47d8-805c-af08dbde2314", "180": "ef990dc7-f313-4b4f-be28-af53469041bc", "210": "c7fbe467-9b6c-4352-84f7-15b4ae8fab83", "240": "ef644f08-9e2b-4ae2-9a31-bdecb0426268", "270": "180590f4-1d02-4e2e-85c0-0ce94828d815", "300": "eaadc30a-28c3-41bf-b1ba-8eafb18bb53f", "330": "0d5e1b9a-3622-4982-ae6c-c4fed4a054ee"}}, {"id": "horizontal_anchor", "instance": "1d4ab3da-886c-40fc-92e2-52a35e19b526", "latches": []}, {"id": "horizontal_anchor", "instance": "0e0fa9c8-07fd-4746-bf57-40acfa51c8ee", "latches": ["e8139090-7b8b-4900-8848-d3f2e1109e8c"]}, {"id": "vertical_anchor", "instance": "bd80609e-55fd-4f26-9637-cc90386dc718", "latches": ["196cb0fc-b79f-42cb-8d3b-d469913b6551"]}, {"id": "vertical_anchor", "instance": "03f5a30d-a883-