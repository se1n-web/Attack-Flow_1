        {
            "id": "vulnerability",
            "instance": "b4f85d27-1b83-4e18-a172-946950f1994f",
            "properties": [
                [
                    "name",
                    "CVE-2019-11510 (Ivanti / Pulse Connect Secure)"
                ],
                [
                    "description",
                    "This is arguably one of the most famous examples of T1190 targeting a VPN. Attackers hit the public-facing Pulse Secure SSL VPN gateway interface to read arbitrary files, allowing them to steal cleartext admin and user credentials, session cookies, and active session tokens. They immediately turn around and use those credentials to log into the corporate network via the very same VPN."
                ]
            ],
            "anchors": {
