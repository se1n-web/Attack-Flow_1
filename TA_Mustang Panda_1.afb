        {
            "id": "action",
            "instance": "f5803003-d5c1-434c-8fa1-5ef12b2b79ef",
            "properties": [
                [
                    "name",
                    "Valid Accounts"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1078"
                        ]
                    ]
                ],
                [
                    "description",
                    "Mustang Panda leverages valid accounts obtained through phishing, credential theft, or other credential access techniques to gain and maintain access to victim environments. By abusing legitimate user credentials, the group can authenticate to systems, cloud services, email platforms, and network resources while blending in with normal user activity. The use of valid accounts enables Mustang Panda to evade detection, conduct reconnaissance, access sensitive information, establish persistence, and facilitate further espionage operations within compromised networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
