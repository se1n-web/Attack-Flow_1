        {
            "id": "action",
            "instance": "ce3f832f-f671-4c75-8cf2-a1868c43efbf",
            "properties": [
                [
                    "name",
                    "Phishing"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1566"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages phishing campaigns as a primary method for gaining initial access to victim environments. The group distributes deceptive emails that impersonate trusted organizations, recruiters, financial institutions, business partners, or government entities to entice recipients into opening malicious attachments, clicking malicious links, or providing credentials. Successful phishing attacks enable Lazarus to deploy malware, harvest credentials, establish persistence, and gain a foothold within targeted networks in support of espionage, financial theft, and disruptive cyber operations."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
            ],
