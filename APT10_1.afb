"], ["ttp", [["tactic", "TA0001"], ["technique", "T1078"]]], ["description", "Previously stolen credentials are used to access exposed services and enterprise resources. By authenticating with legitimate accounts, APT10 blends in with normal user activity, evades detection, and maintains durable access for discovery, lateral movement, and data collection across compromised environments."], ["confidence", null], ["execution_start", null], ["execution_end", null]], "anchors": {"0": "0a072caa-d772-4e94-adbe-610923a9a4c7", "30": "da920ff2-b854-4048-80bd-b92bc51bd77c", "60": "3a1a122c-6319-48ed-bc3f-ccf7feb91bd3", "90": "5ee94588-bc1a-4069-8333-a27610b697c3", "120": "0a97dfa6-67f0-4c2e-a350-7eb586bbcdfa", "150": "9e8ef544-bea5-400f-a66d-036ca9cdab59", "180": "cf3ec7d3-d401-4d19-bc2e-55d9cf8e53b6", "210": "a2bd5380-c61c-4e68-a3b5-818e980ae85f", "240": "ead89dc4-f9f0-49eb-99f1-58e3bbc74f71", "270": "36d7cceb-da08-4cf9-978a-786f7a98f7af", "300": "84bbd7d9-a6a8-4c66-8c75-9b5912c787b1", "330": "a3d6b2d0-1ce4-43f4-aef8-6c4a584c0f1c"}}, {"id": "horizontal_anchor", "instance": "16acd683-38b4-44a4-91cf-30f1f41822a9", "latches": []}, {"id": "horizontal_anchor", "instance": "8477d5ec-0ca9-4b30-befd-cc75d8fd00c0", "latches": []}, {"id": "vertical_anchor", "instance": "2c546e71-56dd-4982-a743-0dc408026551", "latches": []}, {"id": "vertical_anchor", "instance": "d2bb9ca4-d110-40f9-a8ef-1baba425494c", "latches": ["430e16dd-671c-4822-ac45-3c60bc44a319"]}, {"id": "vertical_anchor", "instance": "10778594-b8e4-4505-aec3-2339da355b6e", "latches": []}, {"id": "horizontal_anchor", "instance": "f1092583-2685-4060-88af-3069592f9ae8", "latches": []}, {"id": "horizontal_anchor", "instance": "cbe429e7-16f9-47b1-9f87-de06da37410c", "latches": []}, {"id": "horizontal_anchor", "instance": "253e4970-614e-4ecd-a668-6bbbbece491c", "latches": []}, {"id": "vertical_anchor", "instance": "739338a2-b359-4d6e-ad58-ef1b4916a0e4", "latches": []}, {"id": "vertical_anchor", "instance": "93fbbdf6-5f52-4f76-80b7-29