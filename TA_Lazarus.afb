        {
            "id": "action",
            "instance": "cfe2021f-5347-4263-b3a1-0ce5433e8a83",
            "properties": [
                [
                    "name",
                    "External Remote Services"
                ],
                [
                    "ttp",
                    [
                        [
                            "tactic",
                            "TA0001"
                        ],
                        [
                            "technique",
                            "T1133"
                        ]
                    ]
                ],
                [
                    "description",
                    "Lazarus Group leverages external remote services such as VPNs, Remote Desktop Protocol (RDP), Citrix, and other internet-accessible remote access platforms to gain and maintain access to victim environments. The group commonly abuses valid credentials obtained through phishing, social engineering, or credential theft to authenticate to these services and bypass perimeter defenses. By leveraging legitimate remote access channels, Lazarus can blend in with normal user activity, establish persistent access, conduct reconnaissance, move laterally, and facilitate data theft or other malicious operations within compromised networks."
                ],
                [
                    "confidence",
                    null
                ],
                [
                    "execution_start",
                    null
                ],
                [
                    "execution_end",
                    null
                ]
